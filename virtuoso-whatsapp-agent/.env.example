# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# Claude Code te ayuda a llenar estos valores durante el setup.
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: meta | twilio
WHATSAPP_PROVIDER=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# Configurar en: https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# Configurar en: https://twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produccion (PostgreSQL en Railway): en Railway usa el valor ${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── CRM / Panel de administración ─────────────────────────
# Clave secreta para abrir el panel privado en /admin?key=TU-CLAVE
# Invéntala tú (texto largo y secreto). Si la dejas vacía, el panel queda deshabilitado.
ADMIN_KEY=
# WhatsApp de atención a clientes para traspaso (formato internacional, solo dígitos)
WHATSAPP_ATENCION=5219983441662

# ── Notificación automática al equipo (handoff) ───────────
# Sofía avisa a esta línea cuando ya dio precios o el cliente pide cita/llamada.
NOTIFY_WHATSAPP=5219983441662
# CallMeBot (recomendado, gratis y confiable). Actívalo una vez:
#  1) Desde el WhatsApp 998 344 1662 envía "I allow callmebot to send me messages"
#     al número +34 644 51 95 23
#  2) CallMeBot te responde con tu apikey. Pon aquí el teléfono y la apikey:
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
