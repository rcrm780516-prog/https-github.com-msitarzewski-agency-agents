{
  "name": "gemmae-ginecologos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sitio oficial de GEMMAE Ginecologos - Astro SSG optimizado para Hostinger",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "audit:seo": "node scripts/audit.mjs",
    "demo:images": "node scripts/generate-demo-images.mjs",
    "demo": "PUBLIC_DEMO=true astro build && node scripts/build-demo.mjs",
    "presentacion": "PUBLIC_DEMO=true astro build && node scripts/build-demo.mjs --presentacion",
    "presentacion:hosting": "PUBLIC_DEMO=true astro build && node scripts/build-demo.mjs --presentacion --absolutas --salida=demo-hosting"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.2.10",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "cheerio": "^1.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
