# ============================================================
# GEMMAE — Variables de entorno
# Copiar como .env y completar. Solo las variables PUBLIC_ llegan al navegador.
# NINGÚN secreto debe ir aquí: las credenciales del webhook viven en
# public/api/config.php, que no se versiona y está bloqueado por .htaccess.
# ============================================================

# --- Dominio (sin barra final). Define canonical, sitemap y robots ---
PUBLIC_SITE_URL=https://gemmaeginecologos.com

# --- Contacto ---
# WhatsApp en formato internacional, solo dígitos (52 + 10 dígitos)
PUBLIC_WHATSAPP=
PUBLIC_WHATSAPP_DISPLAY=
PUBLIC_PHONE=
PUBLIC_PHONE_HREF=
PUBLIC_EMAIL=

# --- Perfiles oficiales (se usan en schema sameAs y footer) ---
PUBLIC_INSTAGRAM=
PUBLIC_FACEBOOK=
PUBLIC_TIKTOK=
PUBLIC_YOUTUBE=
PUBLIC_DOCTORALIA=
PUBLIC_GOOGLE_BUSINESS=

# --- Medición. Si se deja vacío, el script NO se inyecta (cero terceros) ---
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LABEL=

# --- Formulario ---
PUBLIC_FORM_ENDPOINT=/api/lead.php

# --- Tipografías autoalojadas (ver public/fonts/fonts.css) ---
PUBLIC_SELF_HOSTED_FONTS=false
