---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import LocationFinder from '../../components/LocationFinder.astro';
import LocationCard from '../../components/LocationCard.astro';
import CTASection from '../../components/CTASection.astro';
import { getUbicaciones } from '../../lib/content';
import { routes } from '../../lib/urls';
import { isTBC } from '../../config/site';

const ubicaciones = await getUbicaciones();
const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Ubicaciones', href: routes.ubicaciones },
];
---
<BaseLayout
  title="Ubicaciones GEMMAE en Toluca, Metepec y Zinacantepec"
  description="Conoce las sedes de GEMMAE Ginecólogos en Toluca, Metepec y Zinacantepec: dirección, teléfono, horarios, servicios disponibles y cómo agendar en cada una."
  canonical={routes.ubicaciones}
  crumbs={crumbs}
>
  <PageHeader
    eyebrow="Ubicaciones"
    title="Encuentra tu sede GEMMAE"
    lead="Tres sedes en el Valle de Toluca. Elige la que te quede más cerca: puedes iniciar tu seguimiento en una y continuarlo en otra."
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {ubicaciones.map((u) => {
          const dir = [u.data.address.street, u.data.address.neighborhood, u.data.address.city]
            .filter((p) => p && !isTBC(p))
            .join(', ');
          return (
            <LocationCard
              slug={u.id}
              city={u.data.city}
              name={u.data.name}
              excerpt={u.data.excerpt}
              address={dir || '[POR CONFIRMAR] dirección'}
              phone={u.data.phone}
              hours={u.data.hours}
            />
          );
        })}
      </div>
    </div>
  </section>

  <LocationFinder ubicaciones={ubicaciones} title="Detalle de cada sede" lead="Dirección, horarios, servicios y contacto directo por sede." />

  <CTASection showLocations={false} />
</BaseLayout>
