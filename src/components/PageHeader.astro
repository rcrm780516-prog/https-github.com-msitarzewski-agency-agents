---
import Breadcrumb, { type Crumb } from './Breadcrumb.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
---
<header class="page-head">
  <div class="container">
    {crumbs.length > 0 && <Breadcrumb items={crumbs} />}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="page-head__title">{title}</h1>
    {lead && <p class="lead page-head__lead">{lead}</p>}
    <div class="page-head__actions btn-row">
      <slot name="actions" />
    </div>
  </div>
</header>
