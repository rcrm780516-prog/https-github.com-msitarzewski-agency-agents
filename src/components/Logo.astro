---
export interface Props { class?: string; href?: string; label?: boolean }
const { class: className = '', href = '/', label = true } = Astro.props;
---
<a href={href} class:list={['logo', className]} aria-label="GEMMAE Ginecólogos — Inicio">
  <span class="logo__mark">GEMMAE</span>
  {label && <span class="logo__sub">Ginecólogos</span>}
</a>
