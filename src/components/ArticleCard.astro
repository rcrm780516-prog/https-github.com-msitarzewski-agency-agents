---
import { routes } from '../lib/urls';
import { categoriaLabel, formatDate } from '../lib/content';

export interface Props {
  slug: string;
  title: string;
  excerpt: string;
  category: string;
  publishedAt: Date;
  readingMinutes?: number;
  cover?: string;
  coverAlt?: string;
}
const { slug, title, excerpt, category, publishedAt, readingMinutes, cover, coverAlt } = Astro.props;
---
<article class="card">
  {cover && (
    <div class="card__media">
      <img src={cover} alt={coverAlt || ''} width="600" height="400" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="card__body">
    <a class="chip" href={routes.blogCategoria(category)}>{categoriaLabel(category)}</a>
    <h3 class="card__title" style="margin-top:.4rem">
      <a href={routes.articulo(slug)}>{title}</a>
    </h3>
    <p class="card__text">{excerpt}</p>
    <div class="card__foot article-meta">
      <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
      {readingMinutes && <span>{readingMinutes} min de lectura</span>}
    </div>
  </div>
</article>
