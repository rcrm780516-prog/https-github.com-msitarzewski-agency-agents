---
/**
 * Lista de preguntas frecuentes. El schema FAQPage lo emite la pagina
 * (BaseLayout) con los mismos items, para no duplicar la fuente de verdad.
 */
export interface Props {
  items: { q: string; a: string }[];
  title?: string;
  class?: string;
}
const { items, title, class: className = '' } = Astro.props;
---
{items.length > 0 && (
  <div class:list={[className]}>
    {title && <h2 style="margin-bottom:1.5rem">{title}</h2>}
    <div class="faq">
      {items.map((item) => (
        <details class="faq__item">
          <summary>{item.q}</summary>
          <div class="faq__answer"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
)}
