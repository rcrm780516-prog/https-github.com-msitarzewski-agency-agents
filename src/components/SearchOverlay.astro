---
/** Overlay de busqueda global invocado desde el header (tecla "/" o icono). */
import SearchWidget from './SearchWidget.astro';
import Icon from './Icon.astro';
---
<div
  id="search-overlay"
  class="mobile-menu"
  style="background:color-mix(in srgb, var(--sand-50) 97%, transparent);padding-top:0"
  role="dialog"
  aria-modal="true"
  aria-label="Buscar en GEMMAE"
  hidden
>
  <div class="container container--narrow" style="padding-top:1rem">
    <div class="mobile-menu__head">
      <span class="eyebrow">Buscar</span>
      <button type="button" class="icon-btn" data-search-close aria-label="Cerrar búsqueda">
        <Icon name="close" size={22} />
      </button>
    </div>
    <div style="margin-top:1.5rem">
      <SearchWidget id="search-overlay-input" placeholder="Busca un servicio, médico, sede o artículo…" />
    </div>
    <p class="text-muted" style="margin-top:1.25rem;font-size:.85rem">
      Sugerencias: <a href="/vph/">VPH</a> · <a href="/embarazo/">embarazo</a> ·
      <a href="/colposcopia/">colposcopia</a> · <a href="/ubicaciones/toluca/">Toluca</a>
    </p>
  </div>
</div>
