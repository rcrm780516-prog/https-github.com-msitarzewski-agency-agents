---
/**
 * Set de iconos inline (stroke 1.5, 24x24).
 * Inline y no como sprite externo: son pocos, evitan una peticion extra
 * y no bloquean el render. Sin dependencias de icon fonts.
 */
export interface Props {
  name: string;
  size?: number;
  class?: string;
  title?: string;
}

const { name, size = 20, class: className = '', title } = Astro.props;

const paths: Record<string, string> = {
