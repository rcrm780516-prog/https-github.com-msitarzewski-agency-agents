# ============================================================
# DM Wellness Beauty and Nutrition · configuración Apache
# Para hosting cPanel / Apache. Si usas Netlify, Vercel o
# Cloudflare Pages, este archivo se ignora: usa _headers y
# _redirects en su lugar.
# ============================================================

Options -Indexes
DirectoryIndex index.html

# ---------- HTTPS y dominio canónico ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Forzar sin www (si prefieres con www, invierte esta regla)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Quitar .html de la URL
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# ---------- Encabezados de seguridad ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Content-Security-Policy
  # Amplía las listas si añades el plugin de Facebook, el feed de
  # Instagram, Google Maps o alguna herramienta de analítica.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.facebook.com https://www.google.com; connect-src 'self' https:; base-uri 'self'; form-action 'self'"
</IfModule>

# ---------- Compresión ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---------- Caché ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 month"
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/xml                "access plus 1 day"
</IfModule>

# ---------- Tipos MIME ----------
<IfModule mod_mime.c>
  AddType image/svg+xml                 .svg
  AddType application/manifest+json     .webmanifest
  AddType image/x-icon                  .ico
  AddCharset UTF-8                      .html .css .js .json .xml .svg .txt
</IfModule>
